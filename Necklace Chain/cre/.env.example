# Copy to cre/.env (never commit). Used by the cre CLI.

# Funded test key used by `cre workflow simulate --broadcast` / deploy. Use a throwaway key, never the Council or deployer key.
CRE_ETH_PRIVATE_KEY=

# API-Football key; injected as the API_FOOTBALL_KEY secret (see secrets.yaml).
API_FOOTBALL_KEY_ENV=

# Leave UNSET while simulating. Set only for the deployed workflow, matching the receiver's
# expected workflow id / owner (MatchResultReceiver.setExpectedWorkflowId / setExpectedAuthor).
# CRE_WORKFLOW_ID=
# CRE_WORKFLOW_OWNER=
