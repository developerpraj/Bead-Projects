BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASESCAN_API_KEY=
# Prefer a Foundry keystore (`cast wallet import deployer --interactive`, then `forge script ... --account deployer --sender <address>`).
# PRIVATE_KEY is only a fallback; never commit it.
PRIVATE_KEY=

# Genesis allocation destinations (do not hardcode; set per environment)
ECOSYSTEM_ADDR=
TREASURY_ADDR=
TEAM_VESTING_ADDR=
LIQUIDITY_ADDR=
SEED_VESTING_ADDR=

# Set a beneficiary to have the script deploy an OpenZeppelin cliff vesting wallet (and use it instead of *_VESTING_ADDR).
# Durations are seconds. The defaults (team: 1 year cliff, 4 years total; seed: 6 month cliff, 2 years total) are assumptions: confirm them.
TEAM_BENEFICIARY=
TEAM_VESTING_CLIFF=
TEAM_VESTING_DURATION=
SEED_BENEFICIARY=
SEED_VESTING_CLIFF=
SEED_VESTING_DURATION=

# Set to true to renounce BeadToken ownership at the end of the deployment (fee-exempt list becomes permanent)
RENOUNCE_BEAD_OWNERSHIP=false

# Immutable public-goods recipient (Protocol Guild Base vesting contract)
PUBLIC_GOODS_EOA=0xffaaCCFe120f3fC47f42102cF4F28e837cd49A20

# Council Executor (Gnosis Safe)
COUNCIL_EXECUTOR=

# Oracles (leave UMA_OOV3 empty for a local rehearsal with the deployer as oracle)
# Base Sepolia (84532), from UMA's networks/84532.json and checked on chain: OOv3 default currency is the whitelisted TestnetERC20.
#   UMA_OOV3=0x0F7fC5E6482f096380db6158f978167b57388deE  BOND_CURRENCY=0x7E6d9618Ba8a87421609352d6e711958A97e2512
#   SMART_WALLET_FACTORY=0x0BA5ED0c6AA8c49038F819E587E2633c4A9F428a (Coinbase Smart Wallet factory, code present on Base Sepolia)
UMA_OOV3=
BOND_CURRENCY=
BOND_AMOUNT=
# Chainlink Runtime Environment (Functions was sunset). Forwarder addresses come from the CRE Forwarder Directory:
# use the MockForwarder while running `cre workflow simulate`, the KeystoneForwarder for a deployed workflow.
# PLACEHOLDER (zero address makes the deploy revert): replace with the forwarder or mock forwarder printed by `cre workflow supported-chains`.
CRE_FORWARDER=0x0000000000000000000000000000000000000000
# ethereum-testnet-sepolia-base-1, verified in @chainlink/cre-sdk 1.23.0 (Base mainnet needs its own selector).
CRE_CHAIN_SELECTOR=10344971235874465080
# Leave empty at deploy time: the workflow id depends on the receiver address, so set both after `cre workflow deploy`
# with receiver.setExpectedWorkflowId / setExpectedAuthor (the simulation forwarder supplies no workflow metadata).
CRE_WORKFLOW_ID=
CRE_WORKFLOW_OWNER=
# Production: the shared forwarder lets any CRE workflow call the receiver, so identity must be enforced. When both ids above are set the
# script calls requireWorkflowIdentity (one-way); otherwise call setExpectedWorkflowId, setExpectedAuthor, then requireWorkflowIdentity.
# Hot key allowed to call requestMatchResult, so the receiver owner can be the Council Safe:
CRE_KEEPER=
# Set to true to hand the receiver to COUNCIL_EXECUTOR at the end of the deploy (it then runs the setters above through the Safe).
TRANSFER_RECEIVER_OWNERSHIP=false

# Paymaster. ENTRY_POINT defaults to the canonical v0.6 address on Base (8453) and Base Sepolia (84532).
ENTRY_POINT=
SMART_WALLET_FACTORY=
# Gas deposit (pays UserOps) and locked reputation stake, in wei: 0.04 ETH + 0.01 ETH = 0.05 ETH float
GENESIS_GAS_FLOAT=40000000000000000
PAYMASTER_STAKE=10000000000000000
PAYMASTER_UNSTAKE_DELAY=86400
PAYMASTER_MAX_COST_PER_OP=200000000000000
PAYMASTER_SENDER_DAILY=1000000000000000
PAYMASTER_GLOBAL_DAILY=10000000000000000
